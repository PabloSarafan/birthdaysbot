# Telegram Bot Token
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# Database Directory (optional)
# Директория для хранения базы данных
# По умолчанию: текущая директория
# Для CapRover: /app/data
DB_DIR=/app/data

# Если с сервера api.telegram.org недоступен (Network is unreachable) —
# укажите HTTP/HTTPS/SOCKS5 прокси с доступом к Telegram:
# TELEGRAM_PROXY=http://user:password@proxy.example.com:8080
# TELEGRAM_PROXY=socks5://user:password@proxy.example.com:1080
# TELEGRAM_PROXY=

# Принудительно только IPv4 (по умолчанию включено). Отключить: TELEGRAM_FORCE_IPV4=0
# TELEGRAM_FORCE_IPV4=1

# OpenAI: ключ вынесен в отдельный файл openai.env (см. openai.env.example)

